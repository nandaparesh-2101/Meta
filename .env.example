# =============================================================================
# Meta Ads AI Growth OS — environment configuration
# Copy to .env and fill in only what you actually have. Every value below is
# OPTIONAL for local development: the system runs fully in MOCK DATA MODE
# with none of these set.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Data mode ---------------------------------------------------------------
# mock  -> use bundled mock Meta Ads data (default, no external calls)
# live  -> (NOT IMPLEMENTED YET) would use the real Meta Marketing API
DATA_MODE=mock

# --- Execution safety ---------------------------------------------------------
# disabled            -> no execution provider actions are ever performed (default)
# recommendation_only -> agents may produce recommendations; nothing is executed
# approval_required   -> approved recommendations queue for execution (still no-op today)
# controlled_automation -> reserved for future, fully-guarded auto-execution
EXECUTION_MODE=disabled

# --- Local storage -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/runtime/meta_ads_ai.db

# --- Future: LLM provider (agents run in deterministic MOCK mode without this) --
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Future: Meta Marketing API (NOT connected in this build) ------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
